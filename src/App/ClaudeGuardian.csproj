<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ClaudeGuardian</AssemblyName>
    <RootNamespace>ClaudeGuardian</RootNamespace>
    <AssemblyTitle>Claude Guardian</AssemblyTitle>
    <ApplicationIcon>..\..\icon\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\icon\AppIcon.ico" LogicalName="AppIcon.ico" />
  </ItemGroup>

</Project>
